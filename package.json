{
  "name": "dyd26-raffle",
  "version": "1.0.0",
  "private": true,
  "description": "MOPCY DYD 2026 Raffle Ticket System — Diocesan Youth Day 2026",
  "scripts": {
    "dev:all": "node dev-all.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "vercel dev",
    "build": "prisma generate && npm run build --prefix frontend",
    "postinstall": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:check": "prisma db push --skip-generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit --project frontend/tsconfig.json",
    "check:all": "npm run typecheck && npm run db:check"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@supabase/supabase-js": "^2.47.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "validator": "^13.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/validator": "^13.12.2",
    "@vercel/node": "^4.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "prisma": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
