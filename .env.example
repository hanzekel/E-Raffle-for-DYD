# ============================================================
# DYD26 Raffle Ticket System — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file — only this .env.example.
# In Vercel, set these in the dashboard under Project Settings → Environment Variables.
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# Connection pooler URL (used by Prisma Client at runtime)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL (used by Prisma Migrate — bypasses connection pooler)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase ---
# Project URL — found in Supabase Dashboard → Settings → API
SUPABASE_URL="https://[project-ref].supabase.co"
# Anon key — public, safe for frontend (RLS enforced)
SUPABASE_ANON_KEY="eyJ..."
# Service role key — PRIVATE, full database access, server-side only
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Storage bucket name for proof of payment uploads and generated PDFs
SUPABASE_STORAGE_BUCKET="dyd26-uploads"

# --- Authentication ---
# Secret key for signing JWT tokens — use a strong random string (min 64 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-here-generate-with-crypto-random-bytes"
# JWT token expiry duration
JWT_EXPIRY="2h"
# bcrypt hashing rounds for admin password
BCRYPT_ROUNDS="12"
# Pre-hashed admin password — generate with:
# node -e "const b=require('bcryptjs');b.hash('your-password',12).then(h=>console.log(h))"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="$2a$12$..."

# --- Ticket Configuration ---
# Price per raffle ticket in PHP (no currency symbol)
TICKET_PRICE="100"
# Maximum tickets per registration
MAX_TICKETS_PER_REGISTRATION="10"

# --- Payment Information (displayed to users) ---
# GCash
GCASH_NUMBER="09XXXXXXXXX"
GCASH_NAME="MOPCY DYD 2026"
# Bank Transfer
BANK_NAME="BDO / BPI"
BANK_ACCOUNT_NUMBER="XXXX-XXXX-XXXX"
BANK_ACCOUNT_NAME="MOPCY DYD 2026"

# --- Email (SMTP via Gmail App Password or Resend.io) ---
# For Gmail: host=smtp.gmail.com, port=587, user=your@gmail.com, pass=app-password
# For Resend: host=smtp.resend.com, port=465, user=resend, pass=re_xxx
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
# "From" address shown in outgoing emails
EMAIL_FROM="DYD26 Raffle <noreply@dyd26.com>"

# --- URLs ---
# Frontend URL — used for CORS origin and email links
# Local: http://localhost:5173  |  Production: https://your-domain.vercel.app
FRONTEND_URL="http://localhost:5173"
# Vercel auto-injects this — do not set manually in production
VERCEL_URL=""

# --- Rate Limiting ---
# Admin login: max attempts per window
RATE_LIMIT_ADMIN_LOGIN_MAX="5"
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MINUTES="15"
# Public endpoints: max requests per window
RATE_LIMIT_PUBLIC_MAX="10"
RATE_LIMIT_PUBLIC_WINDOW_MINUTES="60"
